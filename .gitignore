# Dependencies
/vendor/
/node_modules/

# Local configuration (never commit credentials)
/config/config.local.php
.env
.env.*

# Runtime + user generated content.
# Ignore the contents one level down, not the folders themselves, so the
# .gitkeep files survive and a fresh clone still has somewhere to write.
/storage/logs/*
!/storage/logs/.gitkeep
/storage/cache/*
!/storage/cache/.gitkeep
/public/uploads/*/*
!/public/uploads/*/.gitkeep

# Build + tooling artefacts
/dist/
/build/
*.log
npm-debug.log*
yarn-error.log*

# OS + editor cruft
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/

# Merge + patch leftovers
*.orig
*.rej
*.bak
